---
import BaseLayout from "../layouts/BaseLayout.astro";
import FormRenderer from "../components/FormRenderer";
import heroImage from "../assets/06-AfternoonMealOfTheWorker 1.svg";

// Placeholder images to ensure the project compiles
const bgImage1 =
  "https://images.unsplash.com/photo-1518998053401-b15e84852986?q=80&w=2560&auto=format&fit=crop";
const block1 =
  "https://images.unsplash.com/photo-1582555172866-f73bb12a2ab3?q=80&w=1000&auto=format&fit=crop";
const block2 =
  "https://images.unsplash.com/photo-1566127444979-b3d2b654e3d7?q=80&w=1000&auto=format&fit=crop";
const na1 =
  "https://images.unsplash.com/photo-1544928147-79a2dbc1f389?q=80&w=1000&auto=format&fit=crop";
const na2 =
  "https://images.unsplash.com/photo-1572953109213-3be62398eb95?q=80&w=1000&auto=format&fit=crop";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

// Mock Data for initial render
const displayEvents = [
  { title: "Opening Exhibition", upload_date: "2026-05-10", images: block1 },
  { title: "Cultural Workshop", upload_date: "2026-05-15", images: block2 },
];
const articles = [...displayEvents, ...displayEvents];
---

<BaseLayout title="Home | Museo Bulawan" theme="dark">
  <div class="w-screen h-auto flex flex-col items-center overflow-x-hidden">
    <div
      id="home"
      class="w-full min-h-screen bg-cover bg-center bg-no-repeat flex items-center justify-center relative"
      style={`background-image: url('${heroImage.src}')`}
    >
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/50 to-transparent pointer-events-none"
      >
      </div>

      <div
        class="w-full max-w-[140rem] mx-auto px-8 md:px-16 lg:px-32 relative z-10 pt-32 lg:pt-20"
      >
        <h2
          class="text-[#d8ad69] font-bold tracking-[0.15em] uppercase text-4xl md:text-5xl leading-20 drop-shadow-lg"
        >
          Welcome to
        </h2>

        <h1
          class="text-white font-extrabold text-6xl md:text-8xl lg:text-9xl leading-25 tracking-tight drop-shadow-2xl mb-10"
        >
          MUSEO <br /> BULAWAN
        </h1>

        <div class="flex flex-wrap items-center gap-4 mb-16">
          <a
            href="#"
            class="bg-white text-gray-900 font-semibold py-3.5 px-10 text-sm hover:bg-gray-200 transition-colors duration-300"
          >
            Learn More
          </a>
          <a
            href="#"
            class="bg-transparent border border-white text-white font-semibold py-3.5 px-10 text-sm uppercase tracking-wider hover:bg-white hover:text-gray-900 transition-colors duration-300"
          >
            Book a Visit
          </a>
        </div>

        <div class="flex flex-col gap-6 text-white/95">
          <div class="flex items-start gap-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-6 h-6 shrink-0 mt-0.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
            </svg>
            <div>
              <h3 class="font-semibold text-white text-base tracking-wide">
                Museum Hours
              </h3>
              <p class="text-sm font-light text-gray-200 mt-1">
                Open Daily 9:00am-5:00pm, Monday- Friday
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-6 h-6 shrink-0 mt-0.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
              ></path>
            </svg>
            <div>
              <h3 class="font-semibold text-white text-base tracking-wide">
                Museum Location
              </h3>
              <p class="text-sm font-light text-gray-200 mt-1 max-w-sm">
                Camarines Norte Provincial Capitol Grounds, Daet Philippines
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="hidden xl:block absolute left-8 px-15 top-1/2 -translate-y-1/2 z-10 w-0 h-0"
      >
        <div
          class="flex flex-row items-center gap-10 text-white text-sm -rotate-90 whitespace-nowrap absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
        >
          <a
            href="#"
            class="flex items-center gap-2 hover:text-[#d8ad69] transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="currentColor"
              viewBox="0 0 16 16"
              ><path
                d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.036 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"
              ></path></svg
            >
            <span class="px-1 text-lg leading-none mt-0.5">&bull;</span>
            <span>museobulawanofficial</span>
          </a>

          <a
            href="#"
            class="flex items-center gap-2 hover:text-[#d8ad69] transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="currentColor"
              viewBox="0 0 16 16"
              ><path
                d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"
              ></path></svg
            >
            <span class="px-1 text-lg leading-none mt-0.5">&bull;</span>
            <span>Museo Bulawan</span>
          </a>
        </div>
      </div>

      <div
        class="hidden xl:block absolute right-8 px-15 top-1/2 -translate-y-1/2 z-10 w-0 h-0"
      >
        <div
          class="flex flex-row items-center gap-10 text-white text-sm rotate-90 whitespace-nowrap absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
        >
          <a
            href="#"
            class="flex items-center gap-3 hover:text-[#d8ad69] transition-colors"
          >
            <span>Museo Bulawan (Abel C. Icatlo)</span>
          </a>
          <a
            href="#"
            class="flex items-center gap-3 hover:text-[#d8ad69] transition-colors"
          >
            <span>museobulawan</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Learn More Section -->
    <section
      id="learn_more"
      class="w-full bg-white min-h-screen py-24 flex items-center"
    >
      <div
        class="w-full max-w-[140rem] mx-auto px-8 md:px-16 lg:px-32 flex flex-col lg:flex-row items-center gap-16 lg:gap-24"
      >
        <!-- Text Content -->
        <div class="flex-1 flex flex-col justify-center max-w-4xl">
          <p
            class="text-xl md:text-2xl text-justify text-gray-900 leading-[2.2] font-serif"
          >
            <span class="text-4xl md:text-5xl text-[#EFBF04]"
              >Museo Bulawan,</span
            >
            known as the "Golden Museum," is the leading and the most viewer-friendly
            community museum that serves as the nerve center for education and communication
            of the rich cultural, artistic and natural heritage and history of Camarines
            Norte, the ultimate medium for preservation, exhibition of significant
            objects that strengthen the values of the people and deepen their patriotism
            and sense of identity.
          </p>
          <a
            href="/about"
            class="mt-8 flex items-center gap-x-3 text-gray-400 hover:text-gray-800 transition-colors"
          >
            <div class="w-8 h-[1px] bg-gray-400"></div>
            <span class="text-lg font-light tracking-wide"
              >About Museo Bulawan</span
            >
          </a>
        </div>

        <!-- Image with Stacked Frame Effect -->
        <div class="flex-1 relative w-full flex justify-center mt-12 lg:mt-0">
          <div class="relative w-full max-w-[40rem] aspect-[16/10]">
            <!-- Cream Backing Paper -->
            <div
              class="absolute -top-6 -left-6 md:-top-10 md:-left-10 w-full h-full bg-[#FDF8E4] shadow-md border border-black/5 z-0"
            >
            </div>

            <!-- Brown Frame -->
            <div
              class="absolute inset-0 bg-[#A69576] shadow-2xl p-4 md:p-6 z-10 flex"
            >
              <!-- Actual Image -->
              <img
                src={block1}
                alt="Museum Heritage"
                class="w-full h-full object-cover shadow-inner"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="whats_on"
      class="w-full bg-white h-screen flex items-center overflow-hidden py-12"
    >
      <div
        class="w-full max-w-[140rem] mx-auto px-8 md:px-16 lg:px-32 flex flex-col lg:flex-row gap-16 lg:gap-24 items-center h-full"
      >
        <div
          class="flex-1 relative w-full h-full flex items-center justify-center min-h-0"
        >
          <div class="relative w-full max-w-[38rem] h-[80%] max-h-[45rem]">
            <div class="absolute top-0 left-0 w-[60%] h-[90%] bg-[#FCF8ED] z-0">
            </div>
            <div
              class="absolute bottom-4 right-0 w-[75%] h-[70%] bg-[#A89A7E] z-0"
            >
            </div>

            <h3
              class="absolute top-12 left-10 text-6xl md:text-7xl font-serif text-[#2B2B2B] z-20 tracking-wide"
            >
              April
            </h3>

            <div
              class="absolute top-[28%] left-[5%] right-[-5%] z-10 bg-white shadow-2xl p-6 md:p-8"
            >
              <div
                class="grid grid-cols-7 text-right text-[10px] md:text-xs font-semibold text-[#4A4A4A]"
              >
                <div
                  class="pb-4 pr-2 text-center font-bold uppercase tracking-wider text-black"
                >
                  Sun
                </div>
                <div
                  class="pb-4 pr-2 text-center font-bold uppercase tracking-wider text-black"
                >
                  Mon
                </div>
                <div
                  class="pb-4 pr-2 text-center font-bold uppercase tracking-wider text-black"
                >
                  Tue
                </div>
                <div
                  class="pb-4 pr-2 text-center font-bold uppercase tracking-wider text-black"
                >
                  Wed
                </div>
                <div
                  class="pb-4 pr-2 text-center font-bold uppercase tracking-wider text-black"
                >
                  Thur
                </div>
                <div
                  class="pb-4 pr-2 text-center font-bold uppercase tracking-wider text-black"
                >
                  Fri
                </div>
                <div
                  class="pb-4 pr-2 text-center font-bold uppercase tracking-wider text-black"
                >
                  Sat
                </div>

                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2 text-gray-300">
                  30
                </div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2 text-gray-300">
                  31
                </div>
                <div
                  class="h-10 md:h-12 lg:h-14 pr-2 pt-2 bg-[#F3E4C2] shadow-lg relative z-30 transform -translate-y-2 -translate-x-2 text-black font-bold border border-black/5"
                >
                  1
                </div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">2</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">3</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">4</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">5</div>

                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">6</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">7</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">8</div>
                <div
                  class="h-10 md:h-12 lg:h-14 pr-2 pt-2 text-white font-bold bg-[#7C8159] shadow-md relative z-20 transform scale-110"
                >
                  9
                </div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">10</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">11</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">12</div>

                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">13</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">14</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">15</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">16</div>
                <div
                  class="h-10 md:h-12 lg:h-14 pr-2 pt-2 text-black bg-[#F3E4C2] border-r border-black/10 z-10"
                >
                  17
                </div>
                <div
                  class="h-10 md:h-12 lg:h-14 pr-2 pt-2 text-black bg-[#F3E4C2] border-r border-black/10 z-10"
                >
                  18
                </div>
                <div
                  class="h-10 md:h-12 lg:h-14 pr-2 pt-2 text-black bg-[#F3E4C2] z-10"
                >
                  19
                </div>

                <div
                  class="h-10 md:h-12 lg:h-14 pr-2 pt-2 bg-[#F3E4C2] shadow-lg relative z-30 transform translate-y-1 -translate-x-2 text-black font-bold border border-black/5"
                >
                  20
                </div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">21</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">22</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">23</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">24</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">25</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">26</div>

                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">27</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">28</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">29</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2">30</div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2 text-gray-300">
                  1
                </div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2 text-gray-300">
                  2
                </div>
                <div class="h-10 md:h-12 lg:h-14 pr-2 pt-2 text-gray-300">
                  3
                </div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="flex-1 flex flex-col h-full max-h-[45rem] justify-center w-full min-h-0"
        >
          <div class="flex items-center gap-6 mb-8 w-full">
            <div class="flex flex-col gap-2.5 w-24 md:w-32 pt-2">
              <div class="h-[3px] w-full bg-black"></div>
              <div class="h-[3px] w-3/4 bg-black mx-auto mr-0"></div>
            </div>
            <h2
              class="text-5xl md:text-6xl lg:text-7xl font-serif text-[#1C1B19] whitespace-nowrap tracking-wide"
            >
              Whats On?
            </h2>
          </div>

          <div
            class="flex-1 w-full min-h-0 flex flex-col gap-6 overflow-hidden pt-4"
          >
            {
              displayEvents.map((article) => (
                <a
                  href={`/articles`}
                  class="flex-1 w-full relative shadow-md group block overflow-hidden bg-gray-100 border border-black/5"
                >
                  <img
                    src={article.images}
                    alt={article.title}
                    class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-[1.02] transition-transform duration-500"
                  />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="news_events" class="w-full bg-[#1C1B19] min-h-screen py-24">
      <div class="w-full max-w-[140rem] mx-auto px-8 md:px-16 lg:px-32">
        <div class="flex items-center text-gray-400 gap-4 mb-4">
          <div class="w-12 h-px bg-gray-400"></div>
          <span class="text-xl font-light uppercase tracking-widest"
            >Don't Miss</span
          >
        </div>
        <h2 class="text-6xl md:text-8xl font-serif text-white mb-16">
          News & Events
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          {
            articles.slice(0, 4).map((article) => (
              <a
                href={`/articles`}
                class="flex flex-col xl:flex-row gap-6 bg-black/40 p-6 rounded-xl hover:bg-black/60 transition-colors border border-white/5"
              >
                <div
                  class="w-full xl:w-2/5 h-[20rem] rounded-lg bg-cover bg-center"
                  style={`background-image: url('${article.images}')`}
                />
                <div class="w-full xl:w-3/5 flex flex-col justify-between py-2">
                  <h3 class="text-3xl font-bold text-white leading-tight">
                    {article.title}
                  </h3>
                  <div class="flex gap-4 mt-4">
                    <span class="text-[#DAB765] text-lg font-semibold">
                      Exhibition
                    </span>
                    <span class="text-gray-400 text-lg">
                      {article.upload_date}
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
        <div class="flex justify-end">
          <a
            href="/articles"
            class="text-2xl text-white hover:text-[#DAB765] flex items-center gap-4 transition-colors"
          >
            See All Events &rarr;
          </a>
        </div>
      </div>
    </section>

    <section
      id="support"
      class="w-full bg-white min-h-screen py-24 flex items-center"
    >
      <div
        class="w-full max-w-[140rem] mx-auto px-8 md:px-16 lg:px-32 flex flex-col gap-24"
      >
        <div class="flex flex-col lg:flex-row items-center gap-16">
          <div
            class="flex-1 w-full h-[30rem] bg-cover bg-center rounded-xl shadow-xl"
            style={`background-image: url('${na1}')`}
          >
          </div>
          <div
            class="flex-1 flex flex-col items-start lg:items-end text-left lg:text-right"
          >
            <h2 class="text-6xl font-bold text-black mb-6">VISIT US!</h2>
            <p class="text-2xl text-gray-700 leading-relaxed mb-8 max-w-2xl">
              Explore the treasures of Museo Bulawan! Plan your visit today by
              booking a tour or schedule an appointment for research,
              interviews, and more.
            </p>
            <a
              href="/appointment"
              class="border-2 border-black text-black hover:bg-black hover:text-white px-8 py-4 text-2xl font-bold rounded transition-colors"
            >
              BOOK AN APPOINTMENT
            </a>
          </div>
        </div>

        <div class="flex flex-col lg:flex-row-reverse items-center gap-16">
          <div
            class="flex-1 w-full h-[30rem] bg-cover bg-center rounded-xl shadow-xl"
            style={`background-image: url('${na2}')`}
          >
          </div>
          <div class="flex-1 flex flex-col items-start text-left">
            <h2 class="text-6xl font-bold text-black mb-6">
              YOUR SUPPORT MATTERS!
            </h2>
            <p class="text-2xl text-gray-700 leading-relaxed mb-8 max-w-2xl">
              Help us preserve and celebrate our heritage! Contribute to Museo
              Bulawan by donating or lending artifacts to enrich our collection
              and share history with future generations.
            </p>
            <a
              href="/about/support"
              class="border-2 border-black text-black hover:bg-black hover:text-white px-8 py-4 text-2xl font-bold rounded transition-colors"
            >
              SUPPORT US
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      id="feedback"
      class="w-full bg-gray-50 min-h-screen py-24 flex items-center border-t border-gray-200"
