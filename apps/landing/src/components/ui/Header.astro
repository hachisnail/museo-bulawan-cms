---
interface Props {
  theme?: "light" | "dark";
}

const { theme = "light" } = Astro.props;
const currentPath = Astro.url.pathname;

const flags = {
  home: true,
  articles_public: true,
  about: true,
};

const initialBg = theme === "dark" ? "bg-[#1C1B19] shadow-md" : "bg-transparent shadow-md";
const initialText = theme === "dark" ? "text-white" : "text-black";
---

<header
  id="public-header"
  data-theme={theme}
  class={`w-full fixed top-0 z-50 transition-all h-8 duration-300 ${initialBg}`}
>
  <div class="flex w-full max-w-[140rem] mx-auto h-full justify-between items-center px-8 md:px-16 lg:px-32">
    
    <span
      id="header-text"
      class={`${initialText} text-[0.65rem]  transition-colors duration-300`}
    >
      Open Daily 9:00am-5:00pm, Monday- Friday, Close During Holidays
    </span>

    <div class="flex items-center h-full">
      
      <div 
        id="header-links" 
        class="flex items-center h-full transition-all duration-300 opacity-0 -translate-y-4 pointer-events-none mr-3"
      >
        {flags.about && (
          <a href="/about" class={`nav-item px-3 text-xs flex items-center h-full hover:text-gray-400 transition-colors ${initialText}`}>
            About us
          </a>
        )}

        <a href="/appointment" class={`nav-item px-3 text-xs flex items-center h-full hover:text-gray-400 transition-colors ${initialText}`}>
          Visit Us
        </a>
      </div>

      <a
        href={import.meta.env.PUBLIC_LOGIN_URL}
        class={`flex items-center h-full pl-3 ${currentPath === "/login" ? "hidden" : ""}`}
      >
        <span
          id="login-btn"
          class={`${initialText} hover:text-gray-400 font-semibold text-xs transition-colors duration-300`}
        >
          Login
        </span>
      </a>
    </div>

  </div>
</header>

<script>
  const header = document.getElementById("public-header");
  const headerText = document.getElementById("header-text");
  const loginBtn = document.getElementById("login-btn");
  const headerLinks = document.getElementById("header-links");
  const navItems = document.querySelectorAll(".nav-item");

  const theme = header?.getAttribute("data-theme");

  function handleScroll() {
    const isScrolled = window.scrollY > 20;

    if (isScrolled) {
      headerLinks?.classList.remove("opacity-0", "-translate-y-4", "pointer-events-none");
      headerLinks?.classList.add("opacity-100", "translate-y-0");

      header?.classList.remove("bg-transparent");
      header?.classList.add("bg-[#1C1B19]");

      if (theme === "light") {
        headerText?.classList.remove("text-black");
        headerText?.classList.add("text-white");

        loginBtn?.classList.remove("text-black");
        loginBtn?.classList.add("text-white");

        navItems.forEach((item) => {
          item.classList.remove("text-black");
          item.classList.add("text-white");
        });
      }
    } else {
      headerLinks?.classList.remove("opacity-100", "translate-y-0");
      headerLinks?.classList.add("opacity-0", "-translate-y-4", "pointer-events-none");

      if (theme === "light") {
        header?.classList.remove("bg-[#1C1B19]");
        header?.classList.add("bg-transparent");

        headerText?.classList.remove("text-white");
        headerText?.classList.add("text-black");

        loginBtn?.classList.remove("text-white");
        loginBtn?.classList.add("text-black");

        navItems.forEach((item) => {
          item.classList.remove("text-white");
          item.classList.add("text-black");
        });
      }
    }
  }

  handleScroll();
  window.addEventListener("scroll", handleScroll);
</script>