---
import '../styles/global.css';

interface Props {
  theme?: 'light' | 'dark';
  navTheme?: 'light' | 'dark';
  isMinimalLayout?: boolean;
  title?: string;
  ogMeta?: {
    title?: string;
    description?: string;
    image?: string;
    url?: string;
    type?: string;
  };
}

const { 
  theme = 'dark', 
  navTheme = 'dark', 
  isMinimalLayout = false,
  title = 'Museo Bulawan CMS',
  ogMeta,
} = Astro.props;

const containerBg = theme === 'dark' ? 'bg-[#1C1B19]' : 'bg-white';

// Umami Analytics config — uses process.env (SSR/Node.js only, never bundled client-side)
const umamiUrl = process.env.PUBLIC_UMAMI_URL || 'https://analytics.museobulawan.qzz.io';
const umamiWebsiteId = process.env.PUBLIC_UMAMI_WEBSITE_ID || '1f9d2500-1f95-479f-8c01-66049615aa07';

import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import Nav from '../components/ui/Nav.astro';
---

<!DOCTYPE html>
<!-- scroll-smooth for animation, scroll-pt-[8rem] ensures anchors land perfectly below the fixed header -->
<html lang="en" class="scroll-smooth scroll-pt-[8rem]">
<head data-umami-url={umamiUrl} data-umami-id={umamiWebsiteId}>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/LOGO.png" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
  {ogMeta && (
    <>
      <meta property="og:title" content={ogMeta.title || title} />
      {ogMeta.description && <meta property="og:description" content={ogMeta.description} />}
      {ogMeta.image && <meta property="og:image" content={ogMeta.image} />}
      {ogMeta.url && <meta property="og:url" content={ogMeta.url} />}
      <meta property="og:type" content={ogMeta.type || 'website'} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={ogMeta.title || title} />
      {ogMeta.description && <meta name="twitter:description" content={ogMeta.description} />}
      {ogMeta.image && <meta name="twitter:image" content={ogMeta.image} />}
    </>
  )}
  <!-- Umami Analytics: /umami-loader.js reads config from the data-attrs above -->
  <script defer src="/umami-loader.js"></script>
</head>

<body class={`${containerBg} flex flex-col min-h-screen w-full overflow-x-hidden relative m-0`}>

  {!isMinimalLayout && (
    <>
      <Header theme={theme} /> 
      <div class="w-full absolute top-10 left-0 z-30 flex justify-center">
         <Nav theme={navTheme} />
      </div>
    </>
  )}

  <!-- Massively increased horizontal padding (lg:px-32) for that "roomier" side feel -->
 <main
  class="flex-1 z-10 flex flex-col items-center
         w-full max-w-[140rem] mx-auto
          "
>
    <slot /> 
  </main>

  {!isMinimalLayout && (
    <footer class="flex items-center justify-center bg-[#1C1B19] h-fit w-full mt-auto">
       <Footer />
    </footer>
  )}

  <script>
    // Dynamically calculate the offset based on the fixed header height
    function getScrollOffset() {
      const header = document.querySelector('header');
      return header ? header.offsetHeight : 32;
    }

    // Function to handle smooth scrolling to an element with header offset
    function scrollToElement(targetId: string, smooth = true) {
      const target = document.getElementById(targetId);
      if (!target) return;

      const offset = getScrollOffset();
      const elementPosition = target.getBoundingClientRect().top + window.scrollY;
      const offsetPosition = elementPosition - offset;

      window.scrollTo({
        top: offsetPosition,
        behavior: smooth ? 'smooth' : 'auto'
      });
    }

    // Intercept dropdown and scroll links to navigate or smooth scroll
    function setupSectionNavigation() {
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const navLink = target.closest<HTMLAnchorElement>('.nav-dropdown-link, .scroll-link');
        if (!navLink) return;

        const href = navLink.getAttribute('href');
        if (!href) return;

        const hashIndex = href.indexOf('#');
        if (hashIndex === -1) return;
        const sectionId = href.substring(hashIndex + 1);
        if (!sectionId) return;

        const isHomepage = window.location.pathname === '/' || window.location.pathname === '/index.html';

        if (isHomepage) {
          const targetElement = document.getElementById(sectionId);
          if (targetElement) {
            e.preventDefault();
            scrollToElement(sectionId, true);
            history.pushState(null, '', `/#${sectionId}`);
          }
        }
      });
    }

    // Handle scrolling on initial load if hash is present
    function handleInitialScroll() {
      const hash = window.location.hash;
      if (hash && hash.startsWith('#')) {
        const sectionId = hash.substring(1);
        if (document.getElementById(sectionId)) {
          scrollToElement(sectionId, true);
        }
      }
    }

    // Run on startup
    setupSectionNavigation();

    // Handle hash changes (e.g. browser history back/forward)
    window.addEventListener('hashchange', () => {
      const hash = window.location.hash;
      if (hash && hash.startsWith('#')) {
        scrollToElement(hash.substring(1), true);
      }
    });

    // Run layout scroll after load to let layout settle
    if (document.readyState === 'complete') {
      setTimeout(handleInitialScroll, 100);
    } else {
      window.addEventListener('load', () => {
        setTimeout(handleInitialScroll, 100);
      });
    }
  </script>

</body>
</html>