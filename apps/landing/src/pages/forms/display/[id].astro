---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FormRenderer from '../../../components/FormRenderer';
import Logo from "../../../assets/LOGO.png";

// Import background assets for random selection
import bg1 from "../../../assets/06-AfternoonMealOfTheWorker 1.svg";
import bg2 from "../../../assets/visit_us.svg";
import bg3 from "../../../assets/FERNANDO CUETO AMORSOLO, Girl with Jar.svg";
import bg4 from "../../../assets/Fernando-Amorsolo-Women-Bathing-and-Washing Clothes-7463.svg";
import bg5 from "../../../assets/amorsolo-igorot-hills-baguio-1928_orig.jpeg";
import bg6 from "../../../assets/amorsolo-lavenderas-1923_orig.jpeg";
import bg7 from "../../../assets/tropical-lagoon-1923-1923_orig.jpeg";

const backgrounds = [bg1, bg2, bg3, bg4, bg5, bg6, bg7];
const randomBg = backgrounds[Math.floor(Math.random() * backgrounds.length)].src;

const { id } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";
---

<BaseLayout title="Form Submissions Portal | Museo Bulawan" isMinimalLayout={true}>
  <div 
    class="w-full min-h-screen py-16 px-4 md:px-10 relative flex justify-center items-start overflow-y-auto bg-cover bg-center bg-no-repeat"
    style={`background-image: url('${randomBg}')`}
  >
      <!-- Premium dark overlay with no blur to keep background artwork clear -->
      <div class="absolute inset-0 bg-black/45 pointer-events-none"></div>

      <div class="relative z-10 w-full max-w-5xl mt-6 md:mt-10 flex flex-col items-center">
          
          <!-- Logo & Brand Name -->
          <div class="flex items-center gap-x-3 mb-8 text-white select-none">
            <a href="/" title="Home" class="hover:opacity-85 transition-opacity">
              <img src={Logo.src} alt="Museo Bulawan Logo" class="w-14" />
            </a>
            <div class="flex items-center gap-x-2">
              <i class="h-10 w-0.5 rounded-sm bg-white/70"></i>
              <a href="/" class="flex flex-col text-lg justify-center text-white hover:text-yellow-400 transition-colors">
                <span class="font-medium text-2xl leading-5 tracking-wide">Museo</span>
                <span class="font-medium text-2xl leading-5 tracking-wide">Bulawan</span>
              </a>
            </div>
          </div>

          <div class="w-full">
            {id ? (
              <FormRenderer 
                client:only="react" 
                id={id.toUpperCase()} 
                apiBaseUrl={API_URL} 
              />
            ) : (
              <div class="text-center py-32 text-[#D4AF37] font-serif text-3xl tracking-wide flex flex-col items-center gap-6">
                <span class="text-6xl">🏛️</span>
                Form Not Found
                <p class="text-sm font-sans text-zinc-400 font-light tracking-widest uppercase">The requested form does not exist or has been moved.</p>
              </div>
            )}
          </div>
      </div>
  </div>
</BaseLayout>
