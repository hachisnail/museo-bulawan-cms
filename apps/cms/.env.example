# ─── Payload CMS Environment Variables ────────────
# Copy this file to .env.local and fill in the values.

# REQUIRED: JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Express API base URL (used for auth bridge in Users collection)
API_URL=http://localhost:3000

# Comma-separated origins allowed to embed the CMS in an iframe
ADMIN_PANEL_ORIGINS=http://localhost:5173,http://localhost:5174

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4321,http://localhost:4322

# Admin panel origin for postMessage security (must match VITE_CMS_URL in panel-admin)
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:5173
