---
import BaseLayout from '../layouts/BaseLayout.astro';

// CMS base URL — change for production
const CMS_URL = 'http://127.0.0.1:3001';

// Placeholder Background
const bgImage1 = "https://images.unsplash.com/photo-1544928147-79a2dbc1f389?q=80&w=2560&auto=format&fit=crop";
const fallbackImage = "https://images.unsplash.com/photo-1566127444979-b3d2b654e3d7?q=80&w=1000&auto=format&fit=crop";

// Fetch published articles from Payload CMS
let articles: any[] = [];
try {
  const res = await fetch(
    `${CMS_URL}/api/articles?where[_status][equals]=published&depth=1&sort=-publishedAt&limit=50`
  );
  if (res.ok) {
    const data = await res.json();
    articles = data.docs || [];
  }
} catch (e) {
  // CMS may not be running — fall back to empty
  console.warn('Could not fetch articles from CMS:', e);
}

// Fetch categories for the filter dropdown
let categories: any[] = [];
try {
  const res = await fetch(`${CMS_URL}/api/categories?limit=50`);
  if (res.ok) {
    const data = await res.json();
    categories = data.docs || [];
  }
} catch (e) {
  console.warn('Could not fetch categories from CMS:', e);
}

/**
 * Get the cover image URL for an article.
 * Falls back to a placeholder if no cover image is set.
 */
function getCoverUrl(article: any): string {
  if (article.coverImage?.sizes?.card?.url) {
    return `${CMS_URL}${article.coverImage.sizes.card.url}`;
  }
  if (article.coverImage?.url) {
    return `${CMS_URL}${article.coverImage.url}`;
  }
  return fallbackImage;
}
---

<BaseLayout title="Articles | Museo Bulawan" theme="dark">
  
  <div class="w-full min-h-screen bg-[#1C1B19] flex flex-col items-center overflow-x-hidden">
    
    <div 
      class="w-full min-h-[50vh] md:min-h-[60vh] bg-cover bg-center relative flex flex-col items-center justify-center pt-32 pb-24" 
      style={`background-image: url('${bgImage1}')`}
    >
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-[#1C1B19]"></div>
      
      <div class="relative z-10 w-full max-w-[140rem] mx-auto px-8 md:px-16 lg:px-32 flex flex-col items-center">
        <h1 class="text-white font-extrabold text-5xl md:text-7xl lg:text-8xl leading-[1.05] tracking-tight drop-shadow-2xl mb-12 uppercase text-center">
          News & <br class="md:hidden" /> Events
        </h1>
        
        <div class="w-full max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 bg-white rounded-sm overflow-hidden shadow-2xl">
          
          <div class="flex items-center bg-white border-b md:border-b-0 md:border-r border-gray-200 relative">
            <div class="absolute left-6 text-gray-400 pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
              </svg>
            </div>
            <input 
              type="text" 
              placeholder="Search articles..." 
              class="w-full px-14 py-4 md:py-5 text-base md:text-lg text-black bg-transparent focus:outline-none placeholder-gray-500 font-medium" 
            />
          </div>
          
          <div class="relative flex items-center bg-white">
            <select class="w-full px-6 py-4 md:py-5 text-base md:text-lg text-black bg-transparent appearance-none focus:outline-none cursor-pointer font-medium">
              <option value="">All Categories</option>
              {categories.map((cat) => (
                <option value={cat.slug}>{cat.name}</option>
              ))}
            </select>
            <div class="pointer-events-none absolute right-6">
              <svg class="h-5 w-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="w-full max-w-[140rem] mx-auto px-8 md:px-16 lg:px-32 py-16 md:py-24">
      
      {articles.length === 0 && (
        <div class="text-center py-20 flex flex-col items-center">
          <div class="w-16 h-[1px] bg-gray-600 mb-6"></div>
          <p class="text-gray-400 text-xl md:text-2xl font-light tracking-wide">No published articles yet. Check back soon!</p>
        </div>
      )}
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-10 gap-y-16">
        {articles.map((article) => (
          <a 
            href={`/articles/${article.slug || article.id}`} 
            class="flex flex-col gap-6 group"
          >
            <div class="w-full aspect-square overflow-hidden bg-gray-900 border border-white/5">
              <img 
                src={getCoverUrl(article)} 
                alt={article.coverImage?.alt || article.title} 
                class="w-full h-full object-cover transform group-hover:scale-[1.03] transition-transform duration-700 ease-out" 
              />
            </div>
            
            <div class="flex flex-col py-1 flex-1">
              <span class="text-xs font-bold uppercase tracking-[0.15em] text-[#DAB765] mb-3">
                {article.category?.name || 'Exhibition'}
              </span>
              
              <h3 class="text-xl md:text-2xl font-bold text-white uppercase leading-snug mb-3 group-hover:text-gray-300 transition-colors line-clamp-2">
                {article.title}
              </h3>
              
              <span class="text-gray-500 text-sm mb-4">
                {new Date(article.publishedAt || article.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </span>
              
              <p class="text-gray-300 text-sm md:text-base leading-relaxed line-clamp-3 mb-6">
                {article.meta?.description || 'Brief description of the event will be placed here. Explore more details by clicking through to the full article.'}
              </p>

              <div class="mt-auto flex items-center text-sm font-semibold text-gray-500 group-hover:text-[#DAB765] transition-colors gap-2">
                Read Article <span class="text-lg leading-none pt-0.5">&#10230;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      
    </div>

  </div>
</BaseLayout>