---
import '../styles/global.css';

interface Props {
  theme?: 'light' | 'dark';
  navTheme?: 'light' | 'dark';
  isMinimalLayout?: boolean;
  title?: string;
}

const { 
  theme = 'dark', 
  navTheme = 'dark', 
  isMinimalLayout = false,
  title = 'Museo Bulawan CMS'
} = Astro.props;

const containerBg = theme === 'dark' ? 'bg-[#1C1B19]' : 'bg-white';

// Umami Analytics configuration (falls back to HTTPS production endpoint)
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL || 'https://umami-ussccgcg0ss04w4gc48os8wg.ipms-cnsc.com';
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '1f9d2500-1f95-479f-8c01-66049615aa07';

import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import Nav from '../components/ui/Nav.astro';
---

<!DOCTYPE html>
<!-- scroll-smooth for animation, scroll-pt-[8rem] ensures anchors land perfectly below the fixed header -->
<html lang="en" class="scroll-smooth scroll-pt-[8rem]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/LOGO.png" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
  {umamiUrl && umamiWebsiteId && (
    <script defer is:inline src={`${umamiUrl}/script.js`} data-website-id={umamiWebsiteId}></script>
  )}
</head>

<body class={`${containerBg} flex flex-col min-h-screen w-full overflow-x-hidden relative m-0`}>

  {!isMinimalLayout && (
    <>
      <Header theme={theme} /> 
      <div class="w-full absolute top-10 left-0 z-30 flex justify-center">
         <Nav theme={navTheme} />
      </div>
    </>
  )}

  <!-- Massively increased horizontal padding (lg:px-32) for that "roomier" side feel -->
 <main
  class="flex-1 z-10 flex flex-col items-center
         w-full max-w-[140rem] mx-auto
          "
>
    <slot /> 
  </main>

  {!isMinimalLayout && (
    <footer class="flex items-center justify-center bg-[#1C1B19] h-fit w-full mt-auto">
       <Footer />
    </footer>
  )}

</body>
</html>