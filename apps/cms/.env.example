# ─── Payload CMS Environment Variables ────────────
# Copy this file to .env.local and fill in the values.

# REQUIRED: JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Express API base URL (used for auth bridge in Users collection)
API_URL=http://localhost:3000

# Comma-separated origins allowed to embed the CMS in an iframe
ADMIN_PANEL_ORIGINS=http://localhost:5173,http://localhost:5174

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4321,http://localhost:4322

# Admin panel origin for postMessage security (must match VITE_CMS_URL in panel-admin)
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:5173

# --- OPTIONAL: PUBLIC & SERVICE URLS ----------------------------------

# Public URL where this Payload instance is reachable.
# Used by the admin UI for absolute links and by other apps for fetches.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# URL of the main admin dashboard portal (supports comma-separated lists)
PUBLIC_ADMIN_URL=http://localhost:5173

# URL of the Express API backend
PUBLIC_API_URL=http://localhost:3000

# URL of the Astro Landing page frontend
PUBLIC_LANDING_URL=http://localhost:4321

# URL of the Astro Visitor panel frontend
PUBLIC_VISITOR_URL=http://localhost:4322

# Internal URL of the Express API backend (used for server-to-server auth check requests)
# Default matches PUBLIC_API_URL. Set this to http://api:3000 if running in Docker networks.
INTERNAL_API_URL=http://localhost:3000

# Optional extra CORS allowed origins (comma-separated list)
PUBLIC_CORS_ORIGINS=

# --- OPTIONAL: S3 / MinIO STORAGE ------------------------------------
# Uncomment and fill these when wiring uploads to MinIO via
# @payloadcms/storage-s3 (see payload_cms_astro_integration.md §5.B).

# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=museo-cms
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

# --- OPTIONAL: SMTP (transactional email) ----------------------------
# Used if/when Payload sends password-reset or notification emails.

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=no-reply@museobulawan.example
# SMTP_FROM_NAME=Museo Bulawan CMS

# --- OPTIONAL: NODE ENVIRONMENT --------------------------------------
NODE_ENV=development
