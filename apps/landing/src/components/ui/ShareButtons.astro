---
/**
 * ShareButtons — Social media sharing + copy link for articles.
 * Renders Facebook, X/Twitter, LinkedIn share buttons and a copy-to-clipboard button.
 */
interface Props {
  url: string
  title: string
}
const { url, title } = Astro.props
const encodedUrl = encodeURIComponent(url)
const encodedTitle = encodeURIComponent(title)
---

<div class="share-buttons flex items-center gap-3">
  <span class="text-xs text-gray-500 uppercase tracking-widest font-semibold mr-1">Share</span>
  
  <!-- Facebook -->
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn group"
    aria-label="Share on Facebook"
    title="Share on Facebook"
  >
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
    </svg>
  </a>

  <!-- X / Twitter -->
  <a
    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn group"
    aria-label="Share on X"
    title="Share on X"
  >
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
  </a>

  <!-- LinkedIn -->
  <a
    href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn group"
    aria-label="Share on LinkedIn"
    title="Share on LinkedIn"
  >
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
    </svg>
  </a>

  <!-- Copy Link -->
  <button
    class="share-btn group copy-link-btn"
    aria-label="Copy link"
    title="Copy link to clipboard"
    data-url={url}
  >
    <svg class="w-4 h-4 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
    </svg>
    <svg class="w-4 h-4 check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
    </svg>
  </button>
</div>

<style>
  .share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #a1a1aa;
    transition: all 0.25s ease;
    cursor: pointer;
  }
  .share-btn:hover {
    background: rgba(212, 175, 55, 0.15);
    border-color: rgba(212, 175, 55, 0.4);
    color: #D4AF37;
    transform: translateY(-2px);
  }
  .share-btn:active {
    transform: translateY(0);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.copy-link-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = (btn as HTMLElement).dataset.url
        if (!url) return
        
        try {
          await navigator.clipboard.writeText(url)
          
          // Swap icons
          const copyIcon = btn.querySelector('.copy-icon') as HTMLElement
          const checkIcon = btn.querySelector('.check-icon') as HTMLElement
          if (copyIcon && checkIcon) {
            copyIcon.classList.add('hidden')
            checkIcon.classList.remove('hidden')
            ;(btn as HTMLElement).style.color = '#22c55e'
            ;(btn as HTMLElement).style.borderColor = 'rgba(34, 197, 94, 0.4)'
            ;(btn as HTMLElement).style.background = 'rgba(34, 197, 94, 0.1)'
            
            setTimeout(() => {
              copyIcon.classList.remove('hidden')
              checkIcon.classList.add('hidden')
              ;(btn as HTMLElement).style.color = ''
              ;(btn as HTMLElement).style.borderColor = ''
              ;(btn as HTMLElement).style.background = ''
            }, 2000)
          }
        } catch {
          // Fallback for older browsers
          const input = document.createElement('input')
          input.value = url
          document.body.appendChild(input)
          input.select()
          document.execCommand('copy')
          document.body.removeChild(input)
        }
      })
    })
  })
</script>
