---
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/amorsolo-lavenderas-1923_orig.jpeg';

// CMS base URL — change for production
const CMS_URL = import.meta.env.PUBLIC_CMS_URL || 'http://127.0.0.1:3001';

// Placeholder Background
const fallbackImage = "https://images.unsplash.com/photo-1566127444979-b3d2b654e3d7?q=80&w=1000&auto=format&fit=crop";

// Fetch published articles from Payload CMS
let articles: any[] = [];
try {
  const res = await fetch(
    `${CMS_URL}/api/articles?where[_status][equals]=published&depth=1&sort=-publishedAt&limit=50`
  );
  if (res.ok) {
    const data = await res.json();
    articles = data.docs || [];
  }
} catch (e) {
  // CMS may not be running — fall back to empty
  console.warn('Could not fetch articles from CMS:', e);
}

// Fetch categories for the filter dropdown
let categories: any[] = [];
try {
  const res = await fetch(`${CMS_URL}/api/categories?limit=50`);
  if (res.ok) {
    const data = await res.json();
    categories = data.docs || [];
  }
} catch (e) {
  console.warn('Could not fetch categories from CMS:', e);
}

/**
 * Get the cover image URL for an article.
 * Falls back to a placeholder if no cover image is set.
 */
function getCoverUrl(article: any): string {
  if (article.coverImage?.sizes?.card?.url) {
    return `${CMS_URL}${article.coverImage.sizes.card.url}`;
  }
  if (article.coverImage?.url) {
    return `${CMS_URL}${article.coverImage.url}`;
  }
  return fallbackImage;
}
---

<BaseLayout title="Articles | Museo Bulawan" theme="dark">
  
  <div class="w-full min-h-screen bg-[#1A1918] flex flex-col items-center overflow-x-hidden">
    
    <!-- Hero Section -->
    <div 
      class="w-screen h-[50vh] md:h-[60vh] bg-cover bg-center relative flex items-center justify-start" 
      style={`background-image: url('${heroImage.src}')`}
    >
      <div class="absolute inset-0 bg-black/40"></div>
      
      <div class="relative z-10 w-full max-w-[140rem] mx-auto px-8 md:px-16 lg:px-32 flex flex-col gap-5 pt-16">
        
        <h1 class="text-white font-bold text-5xl md:text-7xl lg:text-8xl tracking-tight drop-shadow-xl font-sans">
          News & Events
        </h1>

        <!-- Search & Filter Bar (Edgy, smaller, blending with dark theme) -->
        <div class="flex flex-col md:flex-row gap-3 items-center bg-[#121110]/80 backdrop-blur-md p-2 md:p-3 rounded-lg border border-white/5 w-full max-w-3xl shadow-2xl mt-2">
          
          <!-- Search Input -->
          <div class="relative w-full md:flex-1">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input 
              type="text" 
              id="searchInput"
              placeholder="Search for events or news..." 
              class="w-full bg-[#1A1918] text-gray-200 text-sm border border-gray-700/60 rounded-md py-2.5 pl-10 pr-4 focus:outline-none focus:border-gray-400 transition-all placeholder-gray-500 shadow-inner"
            />
          </div>

          <!-- Category Dropdown -->
          <div class="relative w-full md:w-64">
            <select 
              id="categoryFilter"
              class="w-full bg-[#1A1918] text-gray-200 text-sm border border-gray-700/60 rounded-md py-2.5 px-4 pr-10 appearance-none focus:outline-none focus:border-gray-400 transition-all shadow-inner cursor-pointer"
            >
              <option value="all" class="bg-[#1A1918]">All Categories</option>
              {categories.map((cat) => (
                <option value={cat.name.toLowerCase()} class="bg-[#1A1918]">{cat.name}</option>
              ))}
              <!-- Fallback options if CMS fails or is empty -->
              {categories.length === 0 && (
                <>
                  <option value="article" class="bg-[#1A1918]">Article</option>
                  <option value="news" class="bg-[#1A1918]">News</option>
                  <option value="event" class="bg-[#1A1918]">Event</option>
                </>
              )}
            </select>
            <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="w-full px-6 sm:px-12 md:px-16 lg:px-20 pt-16 pb-24">
      
      {/* State for CMS completely empty */}
      {articles.length === 0 && (
        <div class="text-center py-12 flex flex-col items-center w-full">
          <div class="w-12 h-[1px] bg-gray-700 mb-6"></div>
          <p class="text-gray-400 text-lg md:text-xl font-serif tracking-wide">No published articles yet. Check back soon!</p>
        </div>
      )}

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10 w-full" id="articlesGrid">
        {/* State for JS filtering empty results — inside the grid so col-span-full works */}
        <div id="noResultsState" class="hidden text-center py-12 flex-col items-center w-full col-span-full">
          <div class="w-12 h-[1px] bg-gray-700 mb-6"></div>
          <p class="text-gray-400 text-lg md:text-xl font-serif tracking-wide">No articles match your criteria.</p>
        </div>
        {articles.map((article) => (
          <a 
            href={`/articles/${article.slug || article.id}`} 
            class="article-card flex flex-col gap-5 group items-center text-center"
            data-title={(article.title || 'Events Name').toLowerCase()}
            data-category={(article.category?.name || 'Article').toLowerCase()}
          >
            <!-- Image Container -->
            <div class="w-full aspect-square overflow-hidden bg-gray-900 shadow-lg border border-white/5">
              <img 
                src={getCoverUrl(article)} 
                alt={article.coverImage?.alt || article.title} 
                class="w-full h-full object-cover transform group-hover:scale-[1.03] transition-transform duration-700 ease-out opacity-90 group-hover:opacity-100" 
              />
            </div>
            
            <!-- Text Content -->
            <div class="flex flex-col pt-1 flex-1 items-center w-full">
              <span class="text-[0.65rem] md:text-xs font-semibold text-red-700/90 mb-2 tracking-widest uppercase category-label">
                {article.category?.name || 'Article'}
              </span>
              
              <h3 class="text-xl md:text-2xl font-serif text-[#E8E6E3] leading-snug mb-1 group-hover:text-white transition-colors">
                {article.title || 'Events Name'}
              </h3>
              
              <span class="text-gray-500 text-xs italic font-serif mt-1">
                {article.publishedAt ? new Date(article.publishedAt).toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' }) : 'Month dd, yyyy'}
              </span>
            </div>
          </a>
        ))}
      </div>
      
    </div>

  </div>
</BaseLayout>

<script>
  // Client-side filtering logic
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
    const articles = document.querySelectorAll('.article-card');
    const noResultsState = document.getElementById('noResultsState');

    function filterArticles() {
      if (!searchInput || !categoryFilter) return;
      
      const searchTerm = searchInput.value.toLowerCase().trim();
      const selectedCategory = categoryFilter.value.toLowerCase();
      let visibleCount = 0;

      articles.forEach((article) => {
        const el = article as HTMLElement;
        const title = el.getAttribute('data-title') || '';
        const category = el.getAttribute('data-category') || '';

        const matchesSearch = title.includes(searchTerm);
        const matchesCategory = selectedCategory === 'all' || category === selectedCategory;

        if (matchesSearch && matchesCategory) {
          el.style.display = 'flex';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      // Toggle no results message
      if (noResultsState) {
        if (visibleCount === 0 && articles.length > 0) {
          noResultsState.style.display = 'flex';
        } else {
          noResultsState.style.display = 'none';
        }
      }
    }

    if (searchInput && categoryFilter) {
      searchInput.addEventListener('input', filterArticles);
      categoryFilter.addEventListener('change', filterArticles);
    }
  });
</script>